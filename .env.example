# ---- مدل زبانی (هر API سازگار با OpenAI: OpenAI، OpenRouter، Ollama، vLLM، ...) ----
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=sk-...
LLM_MODEL=anthropic/claude-sonnet-4.5
# اختیاری: JSON اضافه برای بدنه درخواست. برای DeepSeek (متیس) لازم است:
# LLM_EXTRA_BODY={"thinking":{"type":"disabled"}}

# ---- Nextcloud ----
# آدرس سرور بدون / در انتها
NEXTCLOUD_URL=https://cloud.example.com
NEXTCLOUD_USER=ai-assistant
# Settings → Security → Devices & sessions → Create new app password
NEXTCLOUD_APP_PASSWORD=xxxxx-xxxxx-xxxxx-xxxxx-xxxxx
# شناسه تقویم پیش‌فرض (در Nextcloud معمولاً personal)
NEXTCLOUD_CALENDAR=personal
# پوشه‌ای که صورت‌جلسه‌ها در آن ساخته می‌شوند
NEXTCLOUD_MEETINGS_FOLDER=Meetings

# منطقه زمانی برای تفسیر زمان جلسات
APP_TIMEZONE=Asia/Tehran
